# Server Configuration
APP_NAME="Async AI Gateway"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# Upstream Primary Provider (e.g., Groq, vLLM, Ollama)
PRIMARY_PROVIDER_NAME="groq"
PRIMARY_BASE_URL="http://127.0.0.1:8001/v1"
PRIMARY_API_KEY="your-primary-api-key"
PRIMARY_TIMEOUT_SECONDS=30.0

# Upstream Fallback Provider (e.g., Together AI, OpenAI)
FALLBACK_PROVIDER_NAME="together"
FALLBACK_BASE_URL="http://127.0.0.1:8002/v1"
FALLBACK_API_KEY="your-fallback-api-key"
FALLBACK_TIMEOUT_SECONDS=30.0

# Circuit Breaker Configuration
CB_FAILURE_THRESHOLD=5
CB_FAILURE_WINDOW_SECONDS=10.0
CB_RECOVERY_TIMEOUT_SECONDS=15.0
CB_HALF_OPEN_SUCCESS_THRESHOLD=2

# Token Leaky-Bucket Rate Limiter
RATE_LIMITER_ENABLED=true
RATE_LIMITER_CAPACITY_TOKENS=50000
RATE_LIMITER_LEAK_RATE_TOKENS_PER_SECOND=2000.0

# Semantic & Exact Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# Observability
OTEL_SERVICE_NAME="ai-gateway-proxy"
PROMETHEUS_METRICS_ENABLED=true
